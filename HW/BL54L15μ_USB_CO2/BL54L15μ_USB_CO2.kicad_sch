	)
	(text "SBU1 carries VDD (probe reference).\nJP1 is bridged in copper. Cut it if\na USB 3 host holds the board in reset."
		(exclude_from_sim no)
		(at 55.88 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2d35ccbb-f353-5bba-b699-f200fc12f2ed")
	)
	(text "Power, SWD and UART. Same pinout as the DevKit."
		(exclude_from_sim no)
		(at 12.7 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "32a72328-2d6e-51c3-980e-9dd1751de958")
	)
	(text "I²C: 100 kHz, uses 13 kΩ MCU pull-ups\nX1: internal 9 pF load capacitors.\nDC/DC inductor is inside the module."
		(exclude_from_sim no)
		(at 243.84 132.842 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "37a60b1d-125f-5972-9c15-b6f92000d60f")
	)
	(text "R1 damps the ringing when a live cable is plugged in.\nD1 clamps VBUS and the two SWD lines, right behind the receptacle.\nAP2112K: 6.0 V max input, 600 mA, EN tied to VIN.\nThe SCD43 draws 205 mA pulses from the 3.3 V rail."
		(exclude_from_sim no)
		(at 35.56 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d6fdad9-6788-546a-aa15-512b3d293c6a")
	)
	(text "M2, unplated"
