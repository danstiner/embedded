(version 1)
(rule "Fab board edge keep-out"
	(constraint edge_clearance (min 0.381mm))
	(condition "B.Layer == 'Edge.Cuts'"))
# X1 sits right under IC1's bottom row and C2 just left of it, on purpose (README 5.6): their pads
# keep normal clearance, but each lies inside IC1's 1 mm courtyard and the two overlap each other.
(rule "X1 and C2 tucked under IC1"
	(constraint courtyard_clearance (min -1.5mm))
	(condition "(A.Reference == 'X1' || A.Reference == 'C2') && (B.Reference == 'IC1' || B.Reference == 'X1' || B.Reference == 'C2')"))
# The leak front end stands in two columns under the module's corner (README 5.6): R3 and R4 inside IC1's 1 mm
# courtyard, R1 and R3 beside X1; the domes' courtyards (0.8 mm past the 4 mm dome) reach the TVS diodes, X1 and C2.
(rule "Leak front end under the module's corner"
	(constraint courtyard_clearance (min -1.1mm))
	(condition "(A.Reference == 'IC1' || A.Reference == 'X1' || A.Reference == 'P1' || A.Reference == 'P2') && (B.Reference == 'R1' || B.Reference == 'R2' || B.Reference == 'R3' || B.Reference == 'R4' || B.Reference == 'D1' || B.Reference == 'D2' || B.Reference == 'X1' || B.Reference == 'C2')"))
# J1's courtyard is the optional box header's shroud: on the few boards that get one, it covers TP4 and reaches BT1's
# wire joint.
(rule "J1 header shroud over TP4 and BT1"
	(constraint courtyard_clearance (min -1.0mm))
	(condition "A.Reference == 'J1' && (B.Reference == 'BT1' || B.Reference == 'TP4')"))
