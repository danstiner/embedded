	(text "VDD: 1.7 V - 3.3 V within -40 °C to +105 °C\n0.6 uA OFF, 3 uA idle, 29 mA peak +8dBm Tx @ 1.8V\nBLE 6.0, 802.15.4, NFC A-Tag"
		(exclude_from_sim no)
		(at 177.546 165.354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0ddf31b4-eeb3-4ff0-8607-3026471e1f8f")
	)
	(text "Either contact drives or senses (README 5.1).\nArmed A to B: LEAK_A and LEAK_A_RET high, LEAK_B an input\nwith edge wake, LEAK_B_RET low. Swap A and B to reverse.\nParked once wet: all four low.\nThe edge wakes below about 0.4 MΩ across P1 and P2."
		(exclude_from_sim no)
		(at 92 94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1dc5e318-5d15-5d04-a928-856b39e7048a")
	)
	(text "CR2 Non-rechargable Battery"
