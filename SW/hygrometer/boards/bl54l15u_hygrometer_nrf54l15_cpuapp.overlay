#include <dt-bindings/regulator/npm2100.h>

/ {
	aliases {
		boot-led = &red_led;
	};

	/* Matter's DK button library requires a /buttons gpio-keys node. The v4
	 * board has no user button, so keep an empty node here (applies to every
	 * revision); the 2026v3 board overlay adds the actual P0.04 button as the
	 * first child (DK_BTN1). */
	buttons {
		compatible = "gpio-keys";
	};
};

/* Enable LDOSW in load-switch mode at boot so I2C20 sensors (BME688/STCC4) are
 * powered for probing. sensor_init() disables it if no sensors are detected.
 * Use ULP mode, the default high-power mode can burn 2mA+ even with no load. */
&npm2100_ldsw {
	regulator-boot-on;
	regulator-initial-mode = < (NPM2100_REG_LDSW_EN | NPM2100_REG_OPER_ULP) >;
};

/* Enable Bluetooth */
&bt_hci_controller {
	status = "okay";
};
