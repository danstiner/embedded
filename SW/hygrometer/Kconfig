config APP_MEASUREMENT_INTERVAL_SEC
	int "Measurement interval (seconds)"
	default 300
	help
	  Time between periodic measurements. Device sleeps between readings.

config APP_CO2_INTERVAL_DIVISOR
	int "Only fetch STCC4 every Nth measurement cycle"
	default 1
	range 1 60
	help
	  STCC4 CO2 read cadence. Last-known values are reused in the
	  advertisements between fetches.

config APP_PRESSURE_INTERVAL_DIVISOR
	int "Only fetch BME688 pressure every Nth measurement cycle"
	default 1
	range 1 360
	help
	  BME688 pressure read cadence, independent of STCC4. Cached pressure is
	  reused for STCC4 compensation and advertisements between fetches.

config SHT4X_ENABLE
	bool "Enable SHT4x sensor"
	default y
	select SENSOR
	help
	  Enable probing for and using temperature and humidity sensor, if hardware is present.

config SHT4X_USE_HEATER
	bool "Use the built-in heater on the SHT4X for increased accuracy at high RH levels"
	default n
	help
	  Maximum duty cycle for using the heater is 5%

config SHT4X_HEATER_HUMIDITY_THRESH
	int "RH [%] threshold above which the heater will be activated"
	range 0 99
	default 65
	depends on SHT4X_USE_HEATER

config SHT4X_HEATER_PULSE_POWER
	int "Heater Power Setting"
	range 0 2
	default 2
	depends on SHT4X_USE_HEATER
	help
	  0 -> High power heater pulse -> ~200 mW  @3.3V
	  1 -> Medium power heater pulse -> ~110 mW  @3.3V
	  2 -> Low power heater pulse -> ~20 mW  @3.3V

config SHT4X_HEATER_LONG_PULSE_DURATION
	bool "Use long pulse duration Heater setting"
	default y
	depends on SHT4X_USE_HEATER
	help
	  Say 'Y' if you want to use the long pulse duration setting. This sets the pulse time to
	  1.1s. Say 'N' if you want to use the short pulse duration setting, which sets the pulse
	  time to 0.11s.

config BME688_ENABLE
	bool "Enable BME688 sensor"
	default y
	select SENSOR
	help
	  Enable probing for and using pressure and gas sensor, if hardware is present.

config STCC4_ENABLE
	bool "Enable STCC4 sensor"
	default y
	select SENSOR
	help
	  Enable probing for and using CO2 sensor, if hardware is present.

config APP_LEAK_SENSOR
	bool "Enable resistive water-leak sensor"
	default n
	select GPIO
	help
	  Drive/sense a resistive leak sensor (2026v4 hardware). Requires a
	  "soily,leak-sensor" node in devicetree. A wet bridge across the
	  electrodes triggers an interrupt that wakes the device immediately.

config APP_BUZZER
	bool "Enable leak buzzer/siren output"
	default n
	depends on APP_LEAK_SENSOR
	help
	  Drive the buzzer/siren (2026v4 P2.05) on leak detection. Not yet
	  implemented — reserved for a future audible-alarm feature.

config APP_USE_MATTER
	bool "Use Matter/Thread instead of BTHome BLE"
	default n
	help
	  Build the Matter end-device variant.

if APP_USE_MATTER

# Per-board-revision data model: each flag gates the matching cluster in both the app
# code and the selected .zap (see prj_extra_matter_v{3,4}.conf). Temperature, humidity
# and battery (Power Source) are present on every revision, so they have no flag.

config APP_MATTER_PRESSURE
	bool "Expose BME688 pressure over Matter (PressureMeasurement)"
	default n
	help
	  Set for boards with a BME688 (2026v3). The v3 data model includes the
	  Pressure Measurement cluster on endpoint 1.

config APP_MATTER_CO2
	bool "Expose STCC4 CO2 over Matter (CarbonDioxideConcentrationMeasurement)"
	default n
	help
	  Set for boards with an STCC4 (2026v3). Gates the CO2 concentration cluster
	  instance; must match the selected .zap or cluster registration fails at init.

config APP_MATTER_LEAK
	bool "Expose water leak over Matter (Boolean State / Water Leak Detector)"
	default n
	depends on APP_LEAK_SENSOR
	help
	  Set for boards with the resistive leak sensor (2026v4). The v4 data model
	  adds a Water Leak Detector endpoint (Boolean State); a leak is reported
	  immediately via the leak-sensor interrupt.

config APP_MATTER_BATTERY_PERCENT
	bool "Expose battery percentage over Matter (Power Source BatPercentRemaining)"
	default n
	help
	  Set for boards with a real fuel gauge (nPM2100, 2026v3) where a charge
	  percentage is meaningful. Boards on a flat CR2 curve (2026v4) report only
	  the coarse BatChargeLevel and omit this attribute from their data model.

choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_MTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_MTD
endchoice

config CHIP_ENABLE_ICD_SUPPORT
	default y

config CHIP_ICD_LIT_SUPPORT
	default y

config CHIP_ICD_REPORT_ON_ACTIVE_MODE
	default y

# Reduce Thread TX output power to 0 dBm for SED device
config OPENTHREAD_DEFAULT_TX_POWER
	default 0

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
source "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"

endif # APP_USE_MATTER

source "Kconfig.zephyr"
